def http_fetch(url, timeout=30):
try:
req = urllib.request.Request(url, headers={
"User-Agent": "NexusPatternHunter/1.0 (research)",
"Accept": "text/plain,*/*",
})
with urllib.request.urlopen(req, timeout=timeout, context=CTX) as r:
return r.read().decode("utf-8", "ignore")
except Exception as e:
log("HTTP err " + url[:60] + " : " + str(e)[:80], "WARN")
return None


def parse_fasta(texte):
"""Parse un fichier FASTA en (nom, sequence)."""
if not texte:
return []
sequences = []
nom_courant = None
seq_courante = []

for ligne in texte.split("\n"):
ligne = ligne.strip()
if not ligne:
continue
if ligne.startswith(">"):
if nom_courant is not None:
sequences.append((nom_courant, "".join(seq_courante)))
nom_courant = ligne[1:80]
seq_courante = []
else:
seq_courante.append(ligne.upper())
if nom_courant is not None:
sequences.append((nom_courant, "".join(seq_courante)))
return sequences


# ===============================================================
# AGENT 1 - SCANNER
# Lit les sequences brutes, extrait TOUTES les features.
# Ne filtre rien. Ne juge rien. Extrait tout.
# ===============================================================

class AgentScanner:
"""
Agent 1 : lit le brut.
Extrait : repeats, ORFs, enzymes, motifs, codons rares.
Aucun filtre - ce qui est ignore par les autres, on le garde.
"""

def __init__(self):
self.features = {}
self.stats = {
"sequences_lues": 0,
"bases_lues": 0,
"repeats_trouves": 0,
"orfs_trouves": 0,
"motifs_rares": 0,
"enzymes_vues": 0,
}

def scanner_sequence(self, nom, seq):
"""
Extrait toutes les features d'une sequence brute.
Ne filtre RIEN.
"""
features = {
"nom": nom,
"longueur": len(seq),
"repeats": [],
"orfs": [],
"codons_rares": [],
"motifs_ignores": [],
"composition": {},
}

if len(seq) < 50:
return features

# 1. Composition des bases
comp = collections.Counter(seq)
features["composition"] = {
"A": comp.get("A", 0),
"T": comp.get("T", 0),
"G": comp.get("G", 0),
"C": comp.get("C", 0),
"GC_pct": round((comp.get("G", 0) + comp.get("C", 0)) / max(1, len(seq)) * 100, 2),
}

# 2. Repeats directs et inverses (TOUTES les tailles 10-200)
features["repeats"] = self._trouver_repeats(seq)

# 3. ORFs sur les 6 cadres de lecture
features["orfs"] = self._trouver_orfs(seq, min_taille=100)

# 4. Codons rares
features["codons_rares"] = self._trouver_codons_rares(seq)

# 5. Motifs ignores (regions non-codantes avec structure)
features["motifs_ignores"] = self._trouver_motifs_ignores(seq)

self.stats["sequences_lues"] += 1
self.stats["bases_lues"] += len(seq)
self.stats["repeats_trouves"] += len(features["repeats"])
self.stats["orfs_trouves"] += len(features["orfs"])
self.stats["motifs_rares"] += len(features["codons_rares"])

return features

def _trouver_repeats(self, seq):
"""Trouve les repeats directs ET inverses, tailles 10-200."""
repeats = []
n = len(seq)
tailles = [10, 15, 20, 25, 30, 40, 50, 75, 100, 150, 200]

for taille in tailles:
if n < taille * 2:
continue
vus = {}
for i in range(0, n - taille + 1, 5):
motif = seq[i:i + taille]
if motif in vus:
pos_orig = vus[motif]
distance = i - pos_orig
if distance >= taille:
repeats.append({
"motif": motif[:50],
"taille": taille,
"pos1": pos_orig,
"pos2": i,
"distance": distance,
"type": "direct",
})
else:
vus[motif] = i
if len(vus) > 5000:
vus.clear()

# Repeats inverses (palindromes)
for taille in [10, 15, 20, 30]:
if n < taille * 2:
continue
complement = str.maketrans("ATGC", "TACG")
for i in range(0, n - taille * 2, 20):
motif = seq[i:i + taille]
motif_inv = motif[::-1].translate(complement)
pos = seq.find(motif_inv, i + taille)
if pos > 0 and pos - i < 5000:
repeats.append({
"motif": motif[:50],
"taille": taille,
"pos1": i,
"pos2": pos,
"distance": pos - i,
"type": "inverse",
})

return repeats[:200]

def _trouver_orfs(self, seq, min_taille=100):
"""Trouve les ORFs sur les 6 cadres."""
orfs = []
start_codons = ["ATG"]
stop_codons = ["TAA", "TAG", "TGA"]

for cadre in range(3):
i = cadre
while i < len(seq) - 3:
codon = seq[i:i + 3]
if codon in start_codons:
for j in range(i + 3, len(seq) - 3, 3):
stop = seq[j:j + 3]
if stop in stop_codons:
taille = j - i
if taille >= min_taille:
orfs.append({
"debut": i,
"fin": j,
"taille": taille,
"cadre": "+" + str(cadre),
"sequence_debut": seq[i:i + 30],
})
i = j + 3
break
else:
i += 3
else:
i += 3

return orfs[:100]

def _trouver_codons_rares(self, seq):
"""Trouve les codons rares (frequence < 1%)."""
if len(seq) < 60:
return []

codons = collections.Counter()
for i in range(0, len(seq) - 3, 3):
codons[seq[i:i + 3]] += 1

total = sum(codons.values())
if total == 0:
return []

rares = []
for codon, count in codons.items():
freq = count / total
if freq < 0.005 and len(codon) == 3 and all(c in "ATGC" for c in codon):
rares.append({
"codon": codon,
"frequence": round(freq, 6),
"occurrences": count,
})

rares.sort(key=lambda x: x["frequence"])
return rares[:20]

def _trouver_motifs_ignores(self, seq):
"""
Trouve les motifs repete-tete-bete que les algorithmes standards ignorent.
C'est ici qu'on cherche ce que personne ne regarde.
"""
motifs = []
n = len(seq)
if n < 200:
return []

# Fenetres glissantes : on regarde la densite locale de structures
fenetre = 500
pas = 100

for i in range(0, n - fenetre, pas):
bloc = seq[i:i + fenetre]

# Chercher des blocs avec beaucoup de repetitions internes
repeats_locaux = 0
for taille in [8, 10, 12]:
if len(bloc) < taille * 2:
continue
for j in range(0, len(bloc) - taille, 10):
motif = bloc[j:j + taille]
if bloc.count(motif) > 1:
repeats_locaux += 1

# Chercher des transitions AT/GC brusques
transitions = 0
for j in range(1, len(bloc)):
prev_gc = bloc[j - 1] in "GC"
cur_gc = bloc[j] in "GC"
if prev_gc != cur_gc:
transitions += 1

densite_transitions = transitions / max(1, len(bloc))

if repeats_locaux > 5 or densite_transitions > 0.5:
motifs.append({
"position": i,
"fenetre": fenetre,
"repeats_locaux": repeats_locaux,
"densite_transitions": round(densite_transitions, 3),
"extrait": bloc[:80],
"raison": "structure_locale_inhabituelle",
})

motifs.sort(key=lambda x: -(x["repeats_locaux"] + x["densite_transitions"] * 20))
return motifs[:50]


# ===============================================================
# AGENT 2 - CROSS
# Prend les features de l'agent 1 et cherche les CORRELATIONS.
# C'est cet agent qui voit que deux choses sans lien apparent
# sont en fait VOISINES dans la sequence.
# ===============================================================

class AgentCross:
"""
Agent 2 : cherche les correlations.
Il ne lit pas le brut - il lit ce que l'agent 1 a extrait.
Il cherche : les features qui sont PROCHE dans l'espace (position).
Il signale : quand deux features 'interessantes' sont VOISINES.
"""

def __init__(self, distance_max=2000):
self.distance_max = distance_max
self.stats = {
"correlations_trouvees": 0,
"proximites_signalees": 0,
"clusters": 0,
}

def croiser(self, features_scannees):
"""
Prend la liste des features et cherche les correlations.
Retourne les paires qui sont proches dans la sequence.
"""
correlations = []

for feat in features_scannees:
correlations.extend(self._croiser_sequence(feat))

# Trier par score
correlations.sort(key=lambda x: -x["score"])
self.stats["correlations_trouvees"] = len(correlations)
return correlations[:100]

def _croiser_sequence(self, feat):
"""
Cherche les paires de features proches dans une sequence.
C'est ca la magie : ce que personne ne lie.
"""
correlations = []
nom = feat["nom"]
length = feat["longueur"]

# Assembler toutes les features avec leur position
toutes = []

for r in feat.get("repeats", []):
toutes.append({
"type": "repeat_" + r["type"],
"pos": r["pos1"],
"detail": "repeat " + str(r["taille"]) + "bp",
"donnees": r,
})
toutes.append({
"type": "repeat_" + r["type"],
"pos": r["pos2"],
"detail": "repeat " + str(r["taille"]) + "bp",
"donnees": r,
})

for o in feat.get("orfs", []):
toutes.append({
"type": "orf",
"pos": o["debut"],
"detail": "ORF " + str(o["taille"]) + "bp cadre " + o["cadre"],
"donnees": o,
})

for m in feat.get("motifs_ignores", []):
toutes.append({
"type": "motif_ignore",
"pos": m["position"],
"detail": "structure " + m["raison"],
"donnees": m,
})

# Trier par position
toutes.sort(key=lambda x: x["pos"])

# Chercher les paires de TYPE DIFFERENT qui sont proches
for i in range(len(toutes)):
for j in range(i + 1, len(toutes)):
a = toutes[i]
b = toutes[j]

# Distance dans la sequence
distance = abs(b["pos"] - a["pos"])
if distance > self.distance_max:
break

# Ignorer les paires du meme type
if a["type"] == b["type"]:
continue

# Score : plus c'est proche et plus les types sont differents, plus c'est interessant
score = self._scorer(a, b, distance)
if score > 0:
correlations.append({
"sequence": nom,
"a_type": a["type"],
"a_pos": a["pos"],
"a_detail": a["detail"],
"b_type": b["type"],
"b_pos": b["pos"],
"b_detail": b["detail"],
"distance": distance,
"score": score,
"raison": self._raison(a, b, distance),
})

self.stats["clusters"] += 1
return correlations

def _scorer(self, a, b, distance):
"""Score de correlation : plus la distance est faible, plus c'est fort."""
score = 0.0

# Proximite : plus proche = plus fort
if distance < 100:
score += 50
elif distance < 500:
score += 30
elif distance < 1000:
score += 20
elif distance < 2000:
score += 10

# Paires de types specifiques = plus interessant
types_a = a["type"]
types_b = b["type"]
paire = tuple(sorted([types_a, types_b]))

paires_interessantes = [
("motif_ignore", "orf"),
("motif_ignore", "repeat_direct"),
("motif_ignore", "repeat_inverse"),
("orf", "repeat_direct"),
("orf", "repeat_inverse"),
("repeat_direct", "repeat_inverse"),
]

if paire in paires_interessantes:
score += 25

return score

def _raison(self, a, b, distance):
types = [a["type"], b["type"]]
if "repeat_direct" in types and "orf" in types:
return "repeat voisin d'un ORF (possible cluster fonctionnel)"
if "repeat_inverse" in types and "orf" in types:
return "repeat inverse voisin d'un ORF (possible origine de replication)"
if "motif_ignore" in types and "orf" in types:
return "structure ignoree voisine d'un ORF (possible motif regulator)"
if "repeat_direct" in types and "repeat_inverse" in types:
return "repeat direct + inverse voisins (possible structure secondaire)"
return "deux features proches de types differents"


