RESULTATS_GLOBAUX = {"data": None}
RESULTATS_LOCK = threading.RLock()
SCAN_EN_COURS = {"value": False}


class Handler(BaseHTTPRequestHandler):
def log_message(self, *a):
pass

def _send(self, code, content, ctype="application/json"):
try:
gz = None
if len(content) > 500 and "gzip" in self.headers.get("Accept-Encoding", ""):
content = gzip.compress(content, 6)
gz = "gzip"
self.send_response(code)
self.send_header("Content-Type", ctype + "; charset=utf-8")
self.send_header("Access-Control-Allow-Origin", "*")
if gz:
self.send_header("Content-Encoding", gz)
self.send_header("Content-Length", str(len(content)))
self.end_headers()
self.wfile.write(content)
except (BrokenPipeError, ConnectionResetError):
pass

def _json(self, obj, code=200):
self._send(code, json.dumps(obj, ensure_ascii=False, default=str).encode("utf-8"))

def _html(self, html):
self._send(200, html.encode("utf-8"), "text/html")

def do_GET(self):
try:
p = self.path.split("?")[0]
if p in ("/", "/index.html"):
return self._html(HTML.replace("__V__", VERSION))
if p == "/api/resultats":
with RESULTATS_LOCK:
d = RESULTATS_GLOBAUX["data"]
if d is None:
# Essayer de charger depuis le fichier
if os.path.isfile(DB_FILE):
try:
with open(DB_FILE, "r", encoding="utf-8") as f:
d = json.load(f)
with RESULTATS_LOCK:
RESULTATS_GLOBAUX["data"] = d
except Exception:
d = {}
return self._json(d or {})
if p == "/api/health":
return self._json({"status": "ok", "version": VERSION})
return self._json({"erreur": "not found"}, 404)
except Exception as e:
return self._json({"erreur": str(e)[:200]}, 500)

def do_POST(self):
try:
p = self.path.split("?")[0]
if p == "/api/scan":
with RESULTATS_LOCK:
if SCAN_EN_COURS["value"]:
return self._json({"ok": False, "erreur": "scan deja en cours"})
SCAN_EN_COURS["value"] = True

try:
orchestrator = TwoAgentOrchestrator()
resultats = orchestrator.executer(SOURCES)
with RESULTATS_LOCK:
RESULTATS_GLOBAUX["data"] = resultats
return self._json({"ok": True, "correlations": len(resultats["correlations"])})
finally:
with RESULTATS_LOCK:
SCAN_EN_COURS["value"] = False

return self._json({"erreur": "not found"}, 404)
except Exception as e:
with RESULTATS_LOCK:
SCAN_EN_COURS["value"] = False
return self._json({"ok": False, "erreur": str(e)[:200]}, 500)


